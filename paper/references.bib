@techreport{brettResearchSoftwareEngineers2017a,
    type = {Report},
    title = {Research {{Software Engineers}}: {{State Of The Nation Report}} 2017},
    shorttitle = {Research {{Software Engineers}}},
    author = {Brett, Alys and Croucher, Michael and Haines, Robert and Hettrick, Simon and Hetherington, James and Stillwell, Mark and Wyatt, Claire},
    year = 2017,
    month = apr,
    institution = {Zenodo},
    doi = {10.5281/ZENODO.495360},
    urldate = {2026-02-02},
    abstract = {Most research would be impossible without software, and this reliance is forcing a rethink of the skills needed in a {$<$}em{$>$}traditional {$<$}/em{$>$}research group. With the emergence of software as the pre-eminent research tool used across all disciplines, comes the realisation that a significant majority of results are based, ultimately, on the skill of the experts who design and build that software.  The UK has led the world in supporting a new role in academia: the {$<$}em{$>$}Research Software Engineer {$<$}/em{$>$}(RSE). This report describes the new expert community that has flourished in UK research, details the successes that have been achieved, and the barriers that prevent further progress.},
    copyright = {Creative Commons Attribution 4.0, Open Access},
    keywords = {Careers,New roles in research,Research communities,Research Software Engineer,RSE,Software}
}

